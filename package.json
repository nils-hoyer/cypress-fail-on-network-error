{
  "name": "cypress-fail-on-network-error",
  "version": "1.3.0",
  "description": "fail cypress test on network error",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run build:fe",
    "build:fe": "rimraf dist/ && tsc",
    "build:be": "node ./backend/app.cjs",
    "prepack": "npm run build:fe",
    "dev": "npm run dev:fe & npm run dev:be",
    "dev:fe": "nodemon --watch './src' --ext 'ts' --exec 'npm run build:fe'",
    "dev:be": "nodemon --watch './backend/app.cjs' --ext 'cjs' --exec 'npm run build:be'",
    "prettier": "prettier --write \"**/*\"",
    "prettier:check": "prettier --check \"**/*\"",
    "lint": "tsc --noEmit && tsc -p ./test/tsconfig.json && tsc -p ./cypress/tsconfig.json",
    "test": "npm run test:ut && npm run test:it",
    "test:ut": "mocha test/unitTest.ts",
    "test:it": "mocha test/integrationTest.ts --timeout 60000",
    "verify": "npm run build && npm run lint && npm run prettier:check && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nils-hoyer/cypress-fail-on-network-error.git"
  },
  "funding": "https://github.com/sponsors/nils-hoyer",
  "keywords": [
    "cypress",
    "testing",
    "network",
    "request",
    "response",
    "error"
  ],
  "author": "nils-hoyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nils-hoyer/cypress-fail-on-network-error/issues"
  },
  "homepage": "https://github.com/nils-hoyer/cypress-fail-on-network-error#readme",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "chai": "^6.0.0",
    "type-detect": "^4.0.8"
  },
  "peerDependencies": {
    "cypress": ">=8.4.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/type-detect": "4.0.3",
    "cypress": "16.1.1",
    "express": "5.3.0",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  }
}
