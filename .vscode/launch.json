{
    "version": "0.2.0",
    "configurations": [
        {
            "args": [
                "-n",
                "loader=ts-node/esm",
                "${workspaceFolder}/test/unitTest.ts",
                "--timeout",
                "60000",
                "--colors"
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "name": "mocha unit tests",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "request": "launch",
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        },
        {
            "args": [
                "-n",
                "loader=ts-node/esm",
                "${workspaceFolder}/test/integrationTest.ts",
                "--timeout",
                "60000",
                "--colors"
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "name": "mocha integration tests",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "request": "launch",
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        }
    ]
}
